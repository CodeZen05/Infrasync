# InfraSync Server Environment Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Connection String (PostgreSQL format)
# Local: postgresql://USER:PASSWORD@localhost:5432/infrasync?schema=public
# Hosted (Neon/Supabase): postgresql://USER:PASSWORD@HOST/infrasync?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/infrasync?schema=public"

# Authentication
JWT_SECRET="infrasync_jwt_super_secret_key_change_in_production_2026"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# AI Microservice Configuration
AI_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Optional Cloud Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

